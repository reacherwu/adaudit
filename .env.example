# --- AdAudit environment ---

# DeepSeek (report narrative). Without this key the product still works:
# reports fall back to the deterministic template and say so on the page.
DEEPSEEK_API_KEY=

# Creem payments ($49 one-time product). Without these, checkout returns a
# clear "payments not configured" error; the free preview is unaffected.
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
# CREEM_API_BASE=https://api.creem.io/v1   # override for Creem test mode

# Transactional email (Resend). Without this, sends are recorded as
# "not_configured" in the store; the report link is also shown on-page.
RESEND_API_KEY=
MAIL_FROM=AdAudit <reports@adaudit.app>

# Cleanup cron (90-day retention purge + refund_pending retries).
# /api/cron/cleanup refuses to run without it (503). Callers send it as
# "Authorization: Bearer <CRON_SECRET>" (what Vercel Cron sends) or as an
# "x-cron-secret" header. See README "定时清理" and vercel.json.
CRON_SECRET=
# Where admin alerts go (e.g. a refund stuck in refund_pending).
# Defaults to service@adaudit.app.
ADMIN_ALERT_EMAIL=

# Internal stats page gate: send header "x-admin-key: <ADMIN_KEY>" to /admin/stats
# (also used, if set, as the HMAC secret for re-check grant/magic-link signing;
# CREEM_WEBHOOK_SECRET takes precedence there, AUTH_SECRET overrides both)
ADMIN_KEY=

# Optional
# PUBLIC_BASE_URL=https://your-domain.example
# DATA_DIR=./data
# LLM_DAILY_CALL_CAP=200
